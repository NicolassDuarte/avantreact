// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id Int @id @default(autoincrement())
  nome String
  email String @unique
  senha String
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  itens Item[]
  trocasEnviadas Troca[] @relation("TrocasEnviadas")
  trocasRecebidas Troca[] @relation("TrocasRecebidas")
}

model Item {
   id         Int         @id @default(autoincrement())
  titulo     String
  descricao  String
  cidade     String
  bairro     String
  endereco   String
  imagemUrl  String
  status     StatusItem  @default(DISPONIVEL)
  criadoEm   DateTime    @default(now())
  atualizadoEm DateTime  @updatedAt
  donoId     Int
  categoriaId Int
  dono       Usuario     @relation(fields: [donoId], references: [id])
  categoria  Categoria   @relation(fields: [categoriaId], references: [id])
  trocaOferecida Troca[] @relation("ItemOferecido")
  trocaDesejada  Troca[] @relation("ItemDesejado")
}

model Categoria {
  id      Int    @id @default(autoincrement())
  nome    String @unique
  itens   Item[]
}

model Troca {
  id           Int         @id @default(autoincrement())
  itemOferecidoId Int
  itemDesejadoId  Int
  status       StatusTroca @default(PENDENTE)
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt
  ofertanteId  Int
  receptorId   Int

  itemOferecido Item    @relation("ItemOferecido", fields: [itemOferecidoId], references: [id])
  itemDesejado  Item    @relation("ItemDesejado", fields: [itemDesejadoId], references: [id])
  ofertante     Usuario @relation("TrocasEnviadas", fields: [ofertanteId], references: [id])
  receptor      Usuario @relation("TrocasRecebidas", fields: [receptorId], references: [id])
}

enum StatusTroca {
  PENDENTE
  ACEITA
  RECUSADA
  CONCLUIDA
  CANCELADA
}

enum StatusItem {
  DISPONIVEL
  NEGOCIANDO
  INDISPONIVEL
}